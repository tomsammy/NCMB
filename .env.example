# 1. Organization & Examination Branding
ORGANIZATION_NAME="Nigerian Content Development and Monitoring Board (NCDMB)"
EXAM_TITLE="Assessment on Module 1: Digital Foundations"

# 2. Administrator Access Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"
RESET_ADMIN_USERNAME="reset_admin"
RESET_ADMIN_PASSWORD="admin123456"
CBT_SECRET_KEY="ncdmb_digital_foundations_cbt_secure_2026"

# 3. Exam Timing & Scoring Rules (Module 1 Assessment: 60 questions / 60 minutes)
DEFAULT_DURATION_MINUTES=60
QUESTIONS_PER_EXAM=60
MARKS_PER_QUESTION=1.0
TOTAL_MARKS=60

# 4. Server Binding
HOST="127.0.0.1"
PORT=8000

# 5. Database Connection (Leave empty for local zero-config SQLite: cbt.db)
# To use cloud PostgreSQL (Neon, Supabase, Render, AWS RDS):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL=""

# 6. Optional Automated Result Email Service (SMTP)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SENDER_EMAIL=""
